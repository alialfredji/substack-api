# ---------------------------------------------------------------------------
# All of this is OPTIONAL. Every route in this project works with no cookie.
# ---------------------------------------------------------------------------

# Optional Substack session cookie.
#
# Why you might want it: a few fields are "viewer-relative" and only resolve
# when Substack knows who is asking. Most importantly `is_subscribed` and
# `is_following` on the note-reactors endpoint. Without a cookie they are
# always false; with your cookie they tell you exactly who liked your note
# but has not subscribed to you.
#
# Two accepted formats:
#   1. Just the sid value:   SUBSTACK_COOKIE=s%3Aabc123...
#   2. A full cookie header: SUBSTACK_COOKIE=substack.sid=s%3Aabc...; substack.lli=1
#
# How to get it: log into substack.com, open DevTools > Application >
# Cookies > substack.com, copy the value of `substack.sid`.
#
# Treat this like a password. It is full account access. Never commit it.
SUBSTACK_COOKIE=

# Server
PORT=3000
HOST=127.0.0.1

# Politeness controls. Collection has produced real HTTP 429 responses, so the
# defaults serialize requests, leave a gap between starts, and retry transient
# failures with bounded exponential backoff. Retry-After is honored when sent.
SUBSTACK_CONCURRENCY=1
SUBSTACK_MIN_DELAY_MS=250
SUBSTACK_TIMEOUT_MS=15000
SUBSTACK_RETRIES=4
SUBSTACK_RETRY_BASE_DELAY_MS=1000
SUBSTACK_RETRY_MAX_DELAY_MS=60000

# How hard to validate upstream responses against our Zod schemas.
#   lenient (default) - validate, log mismatches, still return the data
#   strict            - throw on mismatch (use in tests / CI)
#   off               - skip validation entirely (fastest)
SUBSTACK_VALIDATE=lenient

# Log every upstream request to stderr: 1 to enable
SUBSTACK_DEBUG=0
