{
  "name": "@alialf/substack-api",
  "version": "0.2.2",
  "description": "Typed client + documented REST gateway for Substack's public (unofficial) API endpoints. Read-only discovery and targeting; cookie optional.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alialfredji/substack-api.git"
  },
  "homepage": "https://github.com/alialfredji/substack-api#readme",
  "bugs": {
    "url": "https://github.com/alialfredji/substack-api/issues"
  },
  "keywords": [
    "substack",
    "api",
    "cli",
    "agent",
    "codex"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "substack-api": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "serve": "tsx src/server/index.ts",
    "cli": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "tsx scripts/smoke.ts",
    "example": "tsx",
    "spec": "tsx scripts/dump-openapi.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^5.2.1",
    "dotenv": "^17.0.0",
    "fastify": "^5.2.1",
    "wreq-js": "3.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
